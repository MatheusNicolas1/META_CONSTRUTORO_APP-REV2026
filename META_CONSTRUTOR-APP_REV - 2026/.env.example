VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_or_live_publishable_key
VITE_N8N_WEBHOOK_URL=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
VITE_ENABLE_ACTIVITY_REALTIME=false

# Monitoring / Release
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_APP_VERSION=v1.0.1-release-candidate

# Local/backend-only values. Do not expose in frontend bundles.
