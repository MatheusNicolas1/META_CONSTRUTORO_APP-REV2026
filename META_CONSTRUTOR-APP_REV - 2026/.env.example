STRIPE_SECRET_KEY=sk_test_or_live_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
RESEND_API_KEY=re_your_resend_key
RESEND_FROM_EMAIL=onboarding@resend.dev
APP_VERSION=v1.0.1-release-candidate

# Optional integration secrets for Supabase Edge Functions.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
