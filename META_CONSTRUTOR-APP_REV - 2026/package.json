{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build || vite build",
    "postbuild": "node scripts/generate-sitemap.mjs && node scripts/prerender-public-routes.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "remotion:preview": "remotion preview src/remotion/index.ts",
    "remotion:render-hero": "remotion render src/remotion/index.ts HeroIntro out/videos/hero-intro.mp4",
    "remotion:render-demo": "remotion render src/remotion/index.ts ProductDemo out/videos/product-demo.mp4",
    "remotion:render-features": "remotion render src/remotion/index.ts FeatureRundown out/videos/feature-rundown.mp4",
    "remotion:render-social": "remotion render src/remotion/index.ts SocialProof out/videos/social-proof.mp4",
    "remotion:render-cta": "remotion render src/remotion/index.ts FinalCTA out/videos/final-cta.mp4",
    "remotion:render-all": "npm run remotion:render-hero && npm run remotion:render-demo && npm run remotion:render-features && npm run remotion:render-social && npm run remotion:render-cta"
  },
